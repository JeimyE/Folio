<UserControl x:Class="Folio.Desktop.Views.ChartOfAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Folio.Desktop.Resources"
             xmlns:conv="clr-namespace:Folio.Desktop.Converters"
             xmlns:vm="clr-namespace:Folio.Desktop.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:AccountTypeDisplayConverter x:Key="AccountTypeDisplay" />
        <conv:NormalBalanceDisplayConverter x:Key="NormalBalanceDisplay" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static res:Strings.ChartOfAccountsTitle}"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource FolioPrimaryBrush}"
                   Margin="0,0,0,12" />

        <!-- A WrapPanel, not a horizontal StackPanel: at a narrower window width the
             search box and every action button (Add child / Edit / Activate-Deactivate
             / Delete disable themselves via the matching command's CanExecute when
             nothing is selected) wrap onto a second line instead of being clipped. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Static res:Strings.ChartOfAccountsSearchPlaceholder}"
                        Width="260"
                        Margin="0,0,16,8" />

            <ui:Button Content="{x:Static res:Strings.ChartOfAccountsAddRoot}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding AddRootAccountCommand}"
                       Margin="0,0,8,8" />
            <ui:Button Content="{x:Static res:Strings.ChartOfAccountsAddChild}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding AddChildAccountCommand}"
                       Margin="0,0,8,8" />
            <ui:Button Content="{x:Static res:Strings.ChartOfAccountsEdit}"
                       Icon="{ui:SymbolIcon Edit24}"
                       Command="{Binding EditAccountCommand}"
                       Margin="0,0,8,8" />

            <ui:Button Content="{x:Static res:Strings.ChartOfAccountsDeactivate}"
                       Icon="{ui:SymbolIcon Power24}"
                       Command="{Binding ToggleActiveCommand}"
                       Margin="0,0,8,8">
                <ui:Button.Style>
                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNode.IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
            <ui:Button Content="{x:Static res:Strings.ChartOfAccountsActivate}"
                       Icon="{ui:SymbolIcon Power24}"
                       Command="{Binding ToggleActiveCommand}"
                       Margin="0,0,8,8">
                <ui:Button.Style>
                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNode.IsActive}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>

            <ui:Button Content="{x:Static res:Strings.ChartOfAccountsDelete}"
                       Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding DeleteAccountCommand}"
                       Margin="0,0,0,8" />
        </WrapPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource FolioErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0"
                      ItemsSource="{Binding RootNodes}"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectedItemChanged="OnTreeViewSelectedItemChanged"
                      Margin="0,0,16,0">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:AccountTreeNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                        <Setter Property="Symbol" Value="Folder24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPostable}" Value="True">
                                                <Setter Property="Symbol" Value="Document24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FolioTextBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FolioTextBrush}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FolioAccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <Border Grid.Column="1"
                    Background="{DynamicResource FolioSurfaceBrush}"
                    CornerRadius="8"
                    Padding="20"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.ChartOfAccountsNoSelectionHint}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource FolioTextBrush}"
                               Visibility="{Binding SelectedDetail, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                    <StackPanel Visibility="{Binding SelectedDetail, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SelectedDetail.Name}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource FolioPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="{x:Static res:Strings.ChartOfAccountsDetailCode}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FolioTextBrush}" />
                        <TextBlock Text="{Binding SelectedDetail.Code}" Foreground="{DynamicResource FolioTextBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="{x:Static res:Strings.ChartOfAccountsDetailType}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FolioTextBrush}" />
                        <TextBlock Text="{Binding SelectedDetail.Type, Converter={StaticResource AccountTypeDisplay}}"
                                   Foreground="{DynamicResource FolioTextBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="{x:Static res:Strings.ChartOfAccountsDetailNormalBalance}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FolioTextBrush}" />
                        <TextBlock Text="{Binding SelectedDetail.NormalBalance, Converter={StaticResource NormalBalanceDisplay}}"
                                   Foreground="{DynamicResource FolioTextBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="{x:Static res:Strings.ChartOfAccountsDetailBalance}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FolioTextBrush}" />
                        <TextBlock Text="{Binding SelectedDetail.Balance, StringFormat=C2}"
                                   Foreground="{DynamicResource FolioTextBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="{x:Static res:Strings.ChartOfAccountsDetailStatus}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FolioTextBrush}" />
                        <TextBlock Foreground="{DynamicResource FolioTextBrush}" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="{x:Static res:Strings.ChartOfAccountsStatusInactive}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDetail.IsActive}" Value="True">
                                            <Setter Property="Text" Value="{x:Static res:Strings.ChartOfAccountsStatusActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Foreground="{DynamicResource FolioTextBrush}" Opacity="0.7">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="{x:Static res:Strings.ChartOfAccountsKindGroup}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDetail.IsPostable}" Value="True">
                                            <Setter Property="Text" Value="{x:Static res:Strings.ChartOfAccountsKindPostable}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
