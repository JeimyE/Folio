<UserControl x:Class="Folio.Desktop.Views.AccountFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Folio.Desktop.Resources"
             xmlns:conv="clr-namespace:Folio.Desktop.Converters"
             Width="420">
    <UserControl.Resources>
        <conv:AccountTypeDisplayConverter x:Key="AccountTypeDisplay" />
        <conv:NormalBalanceDisplayConverter x:Key="NormalBalanceDisplay" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.AccountFormCode}" Style="{StaticResource FolioSecondaryTextStyle}" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsCodeEditable}"
                    FontFamily="{DynamicResource FolioMonoFontFamily}"
                    Foreground="{DynamicResource FolioAccentBrush}"
                    Margin="0,0,0,12" />

        <TextBlock Text="{x:Static res:Strings.AccountFormName}" Style="{StaticResource FolioSecondaryTextStyle}" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    FontFamily="{DynamicResource FolioBodyFontFamily}"
                    Margin="0,0,0,12" />

        <TextBlock Text="{x:Static res:Strings.AccountFormType}" Style="{StaticResource FolioSecondaryTextStyle}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding Type}"
                  FontFamily="{DynamicResource FolioBodyFontFamily}" Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource AccountTypeDisplay}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{x:Static res:Strings.AccountFormNormalBalance}" Style="{StaticResource FolioSecondaryTextStyle}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding NormalBalances}" SelectedItem="{Binding NormalBalance}"
                  FontFamily="{DynamicResource FolioBodyFontFamily}" Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource NormalBalanceDisplay}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <CheckBox Content="{x:Static res:Strings.AccountFormIsPostable}"
                  IsChecked="{Binding IsPostable}"
                  FontFamily="{DynamicResource FolioBodyFontFamily}"
                  Margin="0,0,0,12" />

        <TextBlock Text="{x:Static res:Strings.AccountFormDescription}" Style="{StaticResource FolioSecondaryTextStyle}" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    FontFamily="{DynamicResource FolioBodyFontFamily}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="60"
                    Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource FolioNegativeBrush}"
                   FontFamily="{DynamicResource FolioBodyFontFamily}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
