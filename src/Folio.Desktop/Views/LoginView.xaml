<UserControl x:Class="Folio.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Folio.Desktop.Resources"
             xmlns:conv="clr-namespace:Folio.Desktop.Converters"
             Background="{DynamicResource FolioBackgroundBrush}">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource FolioSurfaceBrush}"
                CornerRadius="8"
                Padding="40"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.AppTitle}"
                           FontSize="38" FontWeight="Bold"
                           Foreground="{DynamicResource FolioPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.AppSubtitle}"
                           FontSize="13"
                           Foreground="{DynamicResource FolioTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,28" />

                <TextBlock Text="{x:Static res:Strings.LoginUsername}" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,16" />

                <TextBlock Text="{x:Static res:Strings.LoginPassword}" Margin="0,0,0,4" />
                <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource FolioErrorBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <ui:Button Content="{x:Static res:Strings.LoginSignIn}"
                           Command="{Binding SignInCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
