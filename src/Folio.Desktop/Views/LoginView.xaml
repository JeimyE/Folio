<UserControl x:Class="Folio.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Folio.Desktop.Resources"
             xmlns:conv="clr-namespace:Folio.Desktop.Converters"
             xmlns:controls="clr-namespace:Folio.Desktop.Controls"
             Background="{DynamicResource FolioPaperBrush}">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid>
        <controls:OffsetShadowCard Width="380" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.AppTitle}"
                           Style="{StaticResource FolioBrandTitleTextStyle}"
                           FontSize="38"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.AppSubtitle}"
                           Style="{StaticResource FolioSecondaryTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,28" />

                <TextBlock Text="{x:Static res:Strings.LoginUsername}" Style="{StaticResource FolioBodyTextStyle}" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="{DynamicResource FolioBodyFontFamily}"
                            Margin="0,0,0,16" />

                <TextBlock Text="{x:Static res:Strings.LoginPassword}" Style="{StaticResource FolioBodyTextStyle}" Margin="0,0,0,4" />
                <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="{DynamicResource FolioBodyFontFamily}"
                                Margin="0,0,0,8" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource FolioNegativeBrush}"
                           FontFamily="{DynamicResource FolioBodyFontFamily}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <ui:Button Content="{x:Static res:Strings.LoginSignIn}"
                           Command="{Binding SignInCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                           Style="{StaticResource FolioPrimaryButtonStyle}"
                           HorizontalAlignment="Stretch"
                           Margin="0,8,0,0" />
            </StackPanel>
        </controls:OffsetShadowCard>
    </Grid>
</UserControl>
