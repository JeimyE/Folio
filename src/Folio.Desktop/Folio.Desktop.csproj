<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <OutputType>WinExe</OutputType>
    <!-- LiveCharts2's WPF package pulls transitive deps (OpenTK, SkiaSharp.Views.WPF) that
         only ship .NET Framework TFM assets; NuGet's compatible fallback works at runtime
         but raises NU1701. See docs/adr/0001-architecture.md. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Required by the "dotnet ef migrations add" startup-project tooling, even though
         Folio.Desktop never calls EF Core design-time APIs itself. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Folio.Infrastructure\Folio.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Fraunces, Source Sans 3 and IBM Plex Mono (OFL-licensed, see Resources/Fonts/*/OFL.txt
       and README.md) embedded as app resources for the "Libro mayor" design system. -->
  <ItemGroup>
    <Resource Include="Resources/Fonts/**/*.ttf" />
  </ItemGroup>

</Project>
