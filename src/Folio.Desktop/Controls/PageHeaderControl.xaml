<UserControl x:Class="Folio.Desktop.Controls.PageHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Folio.Desktop.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:UpperCaseConverter x:Key="UpperCase" />
    </UserControl.Resources>

    <StackPanel>
        <WrapPanel>
            <StackPanel Margin="0,0,24,16">
                <TextBlock Text="{Binding CompanyName, ElementName=Root, Converter={StaticResource UpperCase}}"
                           Style="{StaticResource FolioVersalitasLabelTextStyle}" />
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource FolioPageTitleTextStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <ContentPresenter Content="{Binding HeaderActions, ElementName=Root}" Margin="0,0,0,16" />
        </WrapPanel>

        <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource FolioTitleBrush}" Margin="0,0,0,24" />
    </StackPanel>
</UserControl>
