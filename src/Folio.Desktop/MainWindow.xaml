<ui:FluentWindow x:Class="Folio.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Folio.Desktop.Resources"
                 Title="{x:Static res:Strings.AppTitle}"
                 Height="650" Width="1000"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <!-- No StartupUri — the app opens on either Login or Shell depending on
             whether a session already exists, both reached through this same
             ContentControl via the ShellCoordinatorViewModel's DataTemplates. -->
    </ui:FluentWindow.Resources>
    <!-- The title bar gets its own Grid row (not an overlapping Margin hack) so it
         is given the window's full width — without that, its caption buttons
         (maximize/close) had no room to lay out and only minimize ever showed. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="RootTitleBar" Grid.Row="0" Title="{x:Static res:Strings.AppTitle}" />
        <!-- ContentDialogHost's own Content is the dialog currently showing (it's a
             dimming mask + anchor, not a content wrapper) — ContentDialog.ShowAsync
             sets it internally and clears it back to null on close. It must sit as a
             SIBLING on top of the real page content, in the same cell, never wrap it:
             nesting the page inside it here once made the whole window go blank after
             any dialog closed, because closing replaced the page with null. -->
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentViewModel}" />
            <ui:ContentDialogHost />
        </Grid>
    </Grid>
</ui:FluentWindow>
