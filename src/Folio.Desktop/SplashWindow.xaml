<Window x:Class="Folio.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folio"
        Width="360" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource FolioPaperBrush}">
    <!-- DynamicResource, not literal hex: the real theme (light or dark, read from
         settings.json by App.xaml.cs before this window is constructed — see
         ADR-0014) is already applied by the time this renders, so it opens directly
         in the right theme instead of flashing from light to dark a moment later. -->
    <Border BorderBrush="{DynamicResource FolioTitleBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Folio"
                       Style="{StaticResource FolioBrandTitleTextStyle}"
                       FontSize="40"
                       HorizontalAlignment="Center" />
            <TextBlock Text="by Folivora Software"
                       Style="{StaticResource FolioSecondaryTextStyle}"
                       Margin="0,4,0,24"
                       HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True"
                         Width="180" Height="4"
                         Foreground="{DynamicResource FolioAccentBrush}"
                         Background="{DynamicResource FolioSurfaceBrush}"
                         BorderThickness="0" />
        </StackPanel>
    </Border>
</Window>
