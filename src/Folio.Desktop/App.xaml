<Application x:Class="Folio.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Folio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Folio.Desktop.Views">
    <!-- No StartupUri: MainWindow is created in App.xaml.cs only after the Generic
         Host has finished starting (migrating/seeding the database on first run). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- Folio's own "Bosque" brand palette. IThemeService replaces this
                     entry (and the WPF-UI theme above) together when the theme changes. -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Theme/Folio.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel-first navigation: each ViewModel type maps to its View via
                 a DataTemplate, resolved automatically by any ContentControl bound to
                 an instance of that ViewModel (see ShellCoordinatorViewModel/NavigationService). -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                <views:ShellView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
                <views:WelcomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChartOfAccountsViewModel}">
                <views:ChartOfAccountsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
