<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "Libro mayor" design system (ADR-0014) — reusable text styles. -->

    <Style x:Key="FolioBrandTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioSerifFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTitleBrush}" />
    </Style>

    <Style x:Key="FolioPageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioSerifFontFamily}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTitleBrush}" />
    </Style>

    <!-- Sidebar/section category labels ("Contabilidad", "últimos 6 meses"). -->
    <Style x:Key="FolioSectionLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioSerifFontFamily}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FolioAccentBrush}" />
    </Style>

    <!-- Approximates the mockup's small uppercase/letter-spaced café labels
         ("FOLIVORA SOFTWARE", company name above a page title). WPF's TextBlock has
         no letter-spacing/tracking property at all, so there is no real character
         tracking here — callers must pass already-uppercased text (literals are
         stored upper-case in Strings.resx; the one dynamic case, CompanyName, goes
         through UpperCaseConverter). See ADR-0014. -->
    <Style x:Key="FolioVersalitasLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioBodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FolioAccentBrush}" />
    </Style>

    <Style x:Key="FolioBodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioBodyFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTextBrush}" />
    </Style>

    <Style x:Key="FolioSecondaryTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FolioBodyTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTextSecondaryBrush}" />
    </Style>

    <!-- Account codes everywhere (tree rows, detail panel, recent entries). -->
    <Style x:Key="FolioCodeTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioMonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FolioAccentBrush}" />
    </Style>

    <!-- Every monetary amount in the app, without exception, is mono and
         right-aligned (Jeimy's explicit instruction). -->
    <Style x:Key="FolioAmountTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioMonoFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTextBrush}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="FolioAmountStrongTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FolioAmountTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FolioAmountPositiveTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FolioAmountTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource FolioPositiveBrush}" />
    </Style>

    <Style x:Key="FolioAmountNegativeTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FolioAmountTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource FolioNegativeBrush}" />
    </Style>

    <!-- Account-tree row name styles, by depth. Only root ("nivel 1") accounts use
         the serif group style — everything below is plain body text, bold for
         subgroups. -->
    <Style x:Key="FolioGroupLevelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FolioSerifFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTitleBrush}" />
    </Style>

    <Style x:Key="FolioSubgroupLevelTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FolioBodyTextStyle}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="FolioLeafLevelTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FolioBodyTextStyle}" />

</ResourceDictionary>
