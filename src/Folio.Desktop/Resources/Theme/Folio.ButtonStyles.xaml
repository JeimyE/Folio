<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- "Libro mayor" design system (ADR-0014) — reusable button styles. -->

    <!-- Verde "títulos" relleno — Guardar, Nueva cuenta, y every ContentDialog's
         Primary button. FolioOnTitleBrush (not a hardcoded white) is the
         foreground explicitly, since in dark mode the button fill is the LIGHT
         títulos green and needs dark text for contrast — WPF-UI's own Primary
         appearance doesn't know about that per-theme swap on its own. -->
    <Style x:Key="FolioPrimaryButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="Foreground" Value="{DynamicResource FolioOnTitleBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FolioBodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- Bordered, no fill — Cancelar, Nueva subcuenta, Desactivar. -->
    <Style x:Key="FolioSecondaryButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FolioLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FolioBodyFontFamily}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Red text, no fill, no border — Eliminar. -->
    <Style x:Key="FolioDestructiveButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FolioSecondaryButtonStyle}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FolioNegativeBrush}" />
    </Style>

    <!-- One of the six account-type filter tabs — a RadioButton, not a Button:
         WPF buttons have no built-in "selected" visual state, and six tabs need
         mutual exclusion, which RadioButton already gives for free via GroupName. -->
    <Style x:Key="FolioTabFilterButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="FontFamily" Value="{DynamicResource FolioBodyFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FolioTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="UnderlineBorder"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="UnderlineBorder" Property="BorderBrush" Value="{DynamicResource FolioAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FolioTitleBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
