<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Folio.Desktop.Controls">

    <!-- "Libro mayor" design system (ADR-0014) — default (implicit, no x:Key) style
         for OffsetShadowCard. Two Borders, not one: the back one is the shadow,
         offset by a fixed margin; the front one is the real surface. Used by the
         chart-of-accounts detail panel and the login card — never inside
         AccountFormView, which already lives inside a ContentDialog's own chrome. -->
    <Style TargetType="{x:Type controls:OffsetShadowCard}">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OffsetShadowCard}">
                    <Grid>
                        <Border Background="{DynamicResource FolioShadowBrush}" Margin="4,4,0,0" />
                        <Border Background="{DynamicResource FolioSurfaceBrush}"
                                BorderBrush="{DynamicResource FolioLineBrush}"
                                BorderThickness="1"
                                Margin="0,0,4,4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
