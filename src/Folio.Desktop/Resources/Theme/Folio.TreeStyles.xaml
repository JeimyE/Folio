<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "Libro mayor" design system (ADR-0014). -->

    <!-- Needed by FolioLedgerTreeViewItemStyle below — defined here (not left to a
         consuming view's local resources) since a global ResourceDictionary's
         StaticResource lookups can't see a later view's local resources. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- The code→amount leader line in a ledger row, and any other dashed divider.
         WPF has no stretchable dashed Border, so a near-zero-height Rectangle's
         dashed Stroke is the standard workaround: with Height=1, the top/bottom
         edges of the stroke sit close enough together to read as one dotted line. -->
    <Style x:Key="FolioDottedLineStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Height" Value="1" />
        <Setter Property="StrokeDashArray" Value="1,2" />
        <Setter Property="Stroke" Value="{DynamicResource FolioLineDottedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- The small chevron that expands/collapses a ledger group row. -->
    <Style x:Key="FolioTreeExpanderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent">
                        <Path x:Name="Chevron"
                              Data="M 0 0 L 4 4 L 0 8"
                              Stroke="{DynamicResource FolioTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The chart-of-accounts ledger tree's TreeViewItem. Retemplated, not just
         restyled: the default template puts the header in an Auto-width column, so
         a row can never stretch to the tree's full width — which the dotted leader
         line and the right-aligned amount column both need. Children are indented
         by the ItemsHost margin, so every level's amount still lines up on the same
         right edge. Selection and search-match colors are set directly here, so the
         app-wide SystemColors.Highlight* (títulos green) never reaches this tree. -->
    <Style x:Key="FolioLedgerTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource FolioLineBrush}"
                                BorderThickness="0,0,0,1">
                            <Border x:Name="SelectionEdge" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Style="{StaticResource FolioTreeExpanderStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="24,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource FolioShadowBrush}" />
                        </DataTrigger>
                        <!-- After the search-match trigger, so a selected match shows as selected. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource FolioRowSelectedBrush}" />
                            <Setter TargetName="SelectionEdge" Property="BorderBrush" Value="{DynamicResource FolioTitleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
